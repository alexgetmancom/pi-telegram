[Unit]
Description=Pi Telegram family assistant

[Service]
Type=simple
WorkingDirectory=%h
EnvironmentFile=%h/.config/pi-telegram/secrets.env
ExecStart=/usr/bin/node %h/projects/home/pi-telegram/scripts/serve.mjs
ExecStartPost=/usr/bin/curl --silent --show-error --fail --retry 20 --retry-delay 1 --retry-all-errors http://127.0.0.1:8186/healthz
Restart=always
RestartSec=5
TimeoutStopSec=30
UMask=0077

[Install]
WantedBy=default.target
